      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Get raw LLM response and strip any code fences\nconst rawText = $input.item.json.choices[0].message.content;\nconst cleaned = rawText.replace(/```(?:json)?/gi, '').replace(/```/g, '').trim();\n\n// 2. 🛡️ Self-Healing JSON Extractor\nlet evaluation;\ntry {\n  // Try normal parse first\n  evaluation = JSON.parse(cleaned);\n} catch (err) {\n  // If the model had conversational thoughts or restarted, grab from the last '{'\n  const lastStart = cleaned.lastIndexOf('{');\n  const lastEnd = cleaned.lastIndexOf('}');\n  if (lastStart !== -1 && lastEnd > lastStart) {\n    const isolatedJson = cleaned.slice(lastStart, lastEnd + 1);\n    evaluation = JSON.parse(isolatedJson);\n  } else {\n    throw new Error(\"Unable to extract valid JSON from LLM: \" + err.message);\n  }\n}\n\n// 3. Grab candidate data from Edit node\nconst candidate = $('Edit').first().json;\n\n// 4. 🧼 DATA HYGIENE: Auto-format applicant name to clean Title Case\nconst nameKey = candidate.full_name ? 'full_name' : 'applicant_name';\nif (candidate[nameKey]) {\n  candidate[nameKey] = candidate[nameKey]\n    .trim()\n    .replace(/\\s+/g, ' ')\n    .toLowerCase()\n    .replace(/\\b\\w/g, char => char.toUpperCase());\n}\n\n// 5. Return unified dossier\nreturn {\n  json: {\n    ...candidate,\n    ...evaluation\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
